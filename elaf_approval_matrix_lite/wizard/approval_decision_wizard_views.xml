<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elaf_approval_decision_wizard_form" model="ir.ui.view">
        <field name="name">elaf.approval.decision.wizard.form</field>
        <field name="model">elaf.approval.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Decision">
                <group>
                    <field name="request_id"/>
                    <field name="decision" invisible="1"/>
                    <field name="document_name"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="level_name"/>
                    <field name="comment" string="Comment" placeholder="Optional comment for the audit log"
                           invisible="decision != 'approve'"/>
                    <field name="comment" string="Reason" required="decision == 'reject'"
                           placeholder="Why is this request rejected? (required)"
                           invisible="decision != 'reject'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Approve" class="btn-primary"
                            invisible="decision != 'approve'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger"
                            invisible="decision != 'reject'" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
