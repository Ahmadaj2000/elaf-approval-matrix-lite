<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elaf_approval_request_view_list" model="ir.ui.view">
        <field name="name">elaf.approval.request.list</field>
        <field name="model">elaf.approval.request</field>
        <field name="arch" type="xml">
            <tree string="Approval Requests" create="false" edit="false" delete="false"
                  decoration-info="state == 'pending'" decoration-muted="state in ('cancelled',)">
                <field name="name"/>
                <field name="document_name"/>
                <field name="res_model" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="current_level_name" optional="show"/>
                <field name="current_approver_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="date_requested"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cycle_hours" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'" decoration-warning="state == 'invalidated'"/>
            </tree>
        </field>
    </record>

    <record id="elaf_approval_request_view_form" model="ir.ui.view">
        <field name="name">elaf.approval.request.form</field>
        <field name="model">elaf.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="false" edit="false" delete="false">
                <header>
                    <field name="can_act" invisible="1"/>
                    <field name="is_requester" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="not can_act" data-hotkey="a"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="not can_act" data-hotkey="r"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            invisible="state not in ('pending', 'approved') or not is_requester"
                            confirm="Cancel this approval request?"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            groups="elaf_approval_matrix_lite.group_approval_manager"
                            invisible="state not in ('pending', 'approved') or is_requester"
                            confirm="Cancel this approval request?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <div class="alert alert-danger mb-0" role="alert" invisible="state != 'rejected'">
                    <strong>Rejected:</strong> <field name="reject_reason" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'invalidated'">
                    <strong>Invalidated:</strong> <field name="invalidation_reason" class="d-inline"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_document" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Document</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="document_name"/></h3>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="document_type"/>
                            <field name="requester_id" widget="many2one_avatar_user"/>
                            <field name="partner_id"/>
                            <field name="rule_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Amount">
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="amount_company"/>
                            <field name="date_requested"/>
                            <field name="date_decided" invisible="not date_decided"/>
                            <field name="cycle_hours" invisible="not date_decided"/>
                        </group>
                    </group>
                    <group invisible="state != 'pending'">
                        <field name="current_level_name"/>
                        <field name="current_approver_ids" widget="many2many_avatar_user"/>
                    </group>
                    <notebook>
                        <page string="Levels" name="levels">
                            <field name="level_ids">
                                <tree>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_avatar_user"/>
                                    <field name="approval_progress" string="Approvals"/>
                                    <field name="approved_user_ids" widget="many2many_avatar_user"/>
                                    <field name="date_done"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'active'" decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Log" name="log">
                            <field name="log_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="action"/>
                                    <field name="level_name"/>
                                    <field name="actor_display"/>
                                    <field name="comment"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Integrity" name="integrity" groups="elaf_approval_matrix_lite.group_approval_manager">
                            <group>
                                <field name="fingerprint"/>
                                <field name="res_model"/>
                                <field name="res_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="elaf_approval_request_view_search" model="ir.ui.view">
        <field name="name">elaf.approval.request.search</field>
        <field name="model">elaf.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_name"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <field name="rule_id"/>
                <filter name="to_approve_me" string="Waiting for Me"
                        domain="[('state', '=', 'pending'), ('current_approver_ids', 'in', [uid])]"/>
                <filter name="my_requests" string="My Requests" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="invalidated" string="Invalidated" domain="[('state', '=', 'invalidated')]"/>
                <separator/>
                <filter name="date_requested" string="Requested On" date="date_requested"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                    <filter name="group_model" string="Document Type" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="elaf_approval_request_view_pivot" model="ir.ui.view">
        <field name="name">elaf.approval.request.pivot</field>
        <field name="model">elaf.approval.request</field>
        <field name="arch" type="xml">
            <pivot string="Approval Requests">
                <field name="date_requested" interval="month" type="col"/>
                <field name="state" type="row"/>
                <field name="amount_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="elaf_approval_request_action_mine" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">elaf.approval.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_to_approve_me': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for your approval</p>
            <p>Requests appear here when you are an approver of their current level.</p>
        </field>
    </record>

    <record id="elaf_approval_request_action_all" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">elaf.approval.request</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval requests yet</p>
            <p>Open a Purchase Order covered by a rule and click "Request Approval".</p>
        </field>
    </record>
</odoo>
