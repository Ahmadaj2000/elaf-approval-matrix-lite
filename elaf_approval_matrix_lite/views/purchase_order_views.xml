<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_elaf_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.elaf.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='draft_confirm']" position="before">
                <field name="elaf_can_request_approval" invisible="1"/>
                <field name="elaf_can_approve" invisible="1"/>
                <field name="elaf_lite_exhausted" invisible="1"/>
                <field name="elaf_approval_required" invisible="1"/>
                <field name="elaf_approval_valid" invisible="1"/>
                <button name="action_elaf_request_approval" type="object" string="Request Approval"
                        class="oe_highlight" groups="elaf_approval_matrix_lite.group_approval_user"
                        invisible="not elaf_can_request_approval or elaf_lite_exhausted"/>
                <button name="action_elaf_open_comparison" type="object" string="Approval allowance used"
                        class="btn-secondary" groups="elaf_approval_matrix_lite.group_approval_user"
                        help="The Lite allowance of approval requests is used. Open the edition comparison."
                        invisible="not elaf_can_request_approval or not elaf_lite_exhausted"/>
                <button name="action_elaf_approve" type="object" string="Approve" class="oe_highlight"
                        invisible="not elaf_can_approve"/>
                <button name="action_elaf_reject" type="object" string="Reject" class="btn-danger"
                        invisible="not elaf_can_approve"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="status"
                     invisible="elaf_approval_state != 'pending' or state not in ('draft', 'sent', 'to approve')">
                    <i class="fa fa-hourglass-half me-1" title="Pending"/>
                    <strong>Approval pending</strong> at level <field name="elaf_approval_waiting_for" class="d-inline"/>.
                    The order can be confirmed once it is approved.
                </div>
                <div class="alert alert-success mb-0" role="status"
                     invisible="not elaf_approval_valid or state not in ('draft', 'sent', 'to approve')">
                    <i class="fa fa-check me-1" title="Approved"/>
                    <strong>Approved.</strong> The order can be confirmed.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="elaf_approval_state not in ('rejected', 'invalidated') or state not in ('draft', 'sent', 'to approve')">
                    <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                    <strong>Approval <field name="elaf_approval_state" class="d-inline" readonly="1"/>:</strong>
                    <field name="elaf_approval_reason" class="d-inline"/>.
                    A new approval is required before confirmation.
                </div>
                <div class="alert alert-secondary mb-0" role="status"
                     invisible="not elaf_approval_required or elaf_approval_request_id or state not in ('draft', 'sent')">
                    <i class="fa fa-shield me-1" title="Approval"/>
                    This order requires approval under rule <field name="elaf_approval_rule_id" class="d-inline" readonly="1"/>
                    before it can be confirmed.
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_elaf_view_requests" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" invisible="not elaf_approval_count">
                    <field name="elaf_approval_count" widget="statinfo" string="Approvals"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="elaf_approval_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_list_elaf_approval" model="ir.ui.view">
        <field name="name">purchase.order.list.elaf.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="elaf_approval_state" string="Approval" optional="show" widget="badge"
                       decoration-info="elaf_approval_state == 'pending'"
                       decoration-success="elaf_approval_state == 'approved'"
                       decoration-danger="elaf_approval_state == 'rejected'"
                       decoration-warning="elaf_approval_state == 'invalidated'"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_elaf_approval" model="ir.ui.view">
        <field name="name">purchase.order.search.elaf.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft_rfqs']" position="before">
                <filter name="elaf_approval_pending" string="Approval Pending"
                        domain="[('elaf_approval_state', '=', 'pending')]"/>
                <filter name="elaf_approval_approved" string="Approved (Approval Matrix)"
                        domain="[('elaf_approval_state', '=', 'approved')]"/>
                <filter name="elaf_approval_invalid" string="Approval Rejected or Invalidated"
                        domain="[('elaf_approval_state', 'in', ('rejected', 'invalidated'))]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
