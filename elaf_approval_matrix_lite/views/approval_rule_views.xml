<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elaf_approval_rule_view_list" model="ir.ui.view">
        <field name="name">elaf.approval.rule.list</field>
        <field name="model">elaf.approval.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="level_count" string="Levels"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="elaf_approval_rule_view_form" model="ir.ui.view">
        <field name="name">elaf.approval.rule.form</field>
        <field name="model">elaf.approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="request_count" widget="statinfo" string="Requests"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Purchases above 5,000"/></h1>
                    </div>
                    <group>
                        <group name="scope" string="Scope">
                            <field name="res_model"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="amounts" string="Amount Band (company currency)">
                            <field name="currency_id" invisible="1"/>
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                            <field name="amount_tolerance_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Levels" name="levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="user_ids" widget="many2many_tags"
                                           invisible="approver_type != 'users'"
                                           required="approver_type == 'users'"/>
                                    <field name="group_id" invisible="approver_type != 'group'"
                                           required="approver_type == 'group'"/>
                                </list>
                            </field>
                            <p class="text-muted small">
                                Levels are approved one after another, lowest sequence first. One approval
                                from the listed users (or group members) completes a level. The requester
                                can never approve their own request.
                            </p>
                        </page>
                        <page string="Description" name="note">
                            <field name="note" placeholder="Internal notes about this rule"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="elaf_approval_rule_view_search" model="ir.ui.view">
        <field name="name">elaf.approval.rule.search</field>
        <field name="model">elaf.approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="res_model"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="elaf_approval_rule_action" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">elaf.approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first approval rule</p>
            <p>A rule defines an amount band and the approval levels a Purchase Order needs before it can be confirmed.</p>
        </field>
    </record>
</odoo>
